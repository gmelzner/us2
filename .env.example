# ===========================================
# US2 Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ----- SUPABASE (Public - safe to commit) -----
# These are exposed in the frontend and are safe to share
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ----- SUPABASE EDGE FUNCTIONS (Private) -----
# Set these in Supabase Dashboard > Edge Functions > Secrets
# DO NOT put these in .env files that get committed!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-api-key

# ----- VERCEL CRON (Optional) -----
# Secret to authenticate cron requests (set in Vercel Dashboard)
CRON_SECRET=your-cron-secret-here

# ===========================================
# WHERE TO SET EACH SECRET
# ===========================================
#
# 1. SUPABASE_URL and SUPABASE_ANON_KEY
#    - Already hardcoded in index.html (public keys)
#    - No action needed
#
# 2. SUPABASE_SERVICE_ROLE_KEY
#    - Supabase Dashboard > Project Settings > API > service_role key
#    - Set in: Supabase Dashboard > Edge Functions > Secrets
#
# 3. RESEND_API_KEY
#    - Get from: https://resend.com/api-keys
#    - Set in: Supabase Dashboard > Edge Functions > Secrets
#
# 4. CRON_SECRET
#    - Generate any random string
#    - Set in: Vercel Dashboard > Project Settings > Environment Variables
#    - Also set: Authorization header in vercel.json cron config
